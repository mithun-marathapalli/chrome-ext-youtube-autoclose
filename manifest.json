{
    "manifest_version": 3,
    "name": "Skip ads automated",
    "version": "1.0",
    "description": "For all lazy ashes. Sit and watch, we will skip those ads for you",
    "action": {
        "default_popup": "popup/index.html",
        "default_icon": "icons/yt.png"
    },
    "content_scripts": [
        {
            "js": ["scripts/content.js"],
            "matches": ["https://www.youtube.com/watch?*"]
        }
    ]
}
